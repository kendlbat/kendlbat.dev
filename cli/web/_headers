# build-<hash>/ (wasm glue, filesystem index, snapshot) and the root filesystem files are named by
# their content, so a URL never changes meaning. index.html is not cached and points at the current build.
/build-*
  Cache-Control: public, max-age=31536000, immutable
/alpine-rootfs-flat/*
  Cache-Control: public, max-age=31536000, immutable
