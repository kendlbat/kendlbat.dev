clear
printf '\e[1;36m%s\e[0m\n' "$(cat /etc/motd)"
head -n 2 ~/about.txt
echo
for f in ~/links/*(N); do printf '  \e[2m%-13s\e[0m %s\n' ${f:t} "$(cat $f)"; done
echo
# commands are OSC 8 links to /#<fragment>, which the page turns into that command (see src/lib.rs)
link() { printf '\e]8;;/#%s\e\\%b\e]8;;\e\\' "$1" "$2" }
printf '  %s            list blog posts\n' "$(link blog '\e[1mblog\e[0m')"
printf '  \e[1mblog\e[0m <number>   read a post, images included\n'
printf '  %s   what I have been up to\n' "$(link about '\e[1mcat\e[0m about.txt')"
printf '  %s      what I am listening to\n' "$(link nowplaying '\e[1mnowplaying\e[0m')"
printf '  %s         setup scripts\n' "$(link util '\e[1mls\e[0m util')"
unfunction link
echo
