export ZSH=/root/.oh-my-zsh
ZSH_THEME="bira"
DISABLE_AUTO_UPDATE=true
plugins=()
source $ZSH/oh-my-zsh.sh
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# keep the tty size in sync with the browser terminal: busybox resize asks xterm.js for its size
autoload -Uz add-zsh-hook
_sync_size() { resize >/dev/null }
add-zsh-hook precmd _sync_size
